#!/bin/bash
# Runs as root before the RAMForge session (ExecStartPre=+ in ramforge.service).
# Writes /run/ramforge.env for the unprivileged session.
LOG=/run/ramforge-session.log
SERIAL=/dev/ttyS0
log() {
    echo "[ramforge] $*" >> "$LOG"
    [ -w "$SERIAL" ] && echo "[ramforge] $*" > "$SERIAL" 2>/dev/null
}
touch "$LOG" && chown ramforge: "$LOG"
modprobe -a i2c-dev ee1004 spd5118 jc42 2>/dev/null
# Graphics drivers can take a while on real hardware (firmware loading):
# wait for udev, then up to 10 s for a DRM device. Without one, the session
# falls back to the firmware framebuffer.
udevadm settle -t 20 2>/dev/null
for _ in $(seq 1 15); do
    ls /dev/dri/card* >/dev/null 2>&1 && break
    sleep 1
done

# X fallback on real PCs whose graphics card has no kernel driver: the UEFI
# framebuffer (efifb, /dev/fb0) then hangs below the PCI card in sysfs
# (.../0000:27:00.0/efi-framebuffer.0/graphics/fb0). Xorg 21's fbdevhw
# refuses such a framebuffer on its non-PCI path ("devices/pci" check) and
# cannot find it on its PCI path, so X reports "no screens found".
# Workaround: show X a copy of /sys/class/graphics in which fb0 looks like a
# platform device. Only the link text changes; nothing else reads fb0 there.
# Together with the non-PCI BusID in ramforge-fbdev.conf X then uses /dev/fb0.
# Verified in QEMU (UEFI, PCI VGA without driver, 32 bpp).
G=/sys/class/graphics
if ! ls /dev/dri/card* >/dev/null 2>&1 && readlink "$G/fb0" 2>/dev/null | grep -q devices/pci; then
    mkdir -p /run/ramforge-graphics
    for e in "$G"/*; do ln -sfn "$(readlink "$e")" "/run/ramforge-graphics/$(basename "$e")"; done
    ln -sfn ../../devices/platform/efi-framebuffer.0/graphics/fb0 /run/ramforge-graphics/fb0
    mount --bind /run/ramforge-graphics "$G" && log "Framebuffer-Umgehung aktiv (fb0 an PCI-Karte ohne Treiber)"
fi
log "Framebuffer: $(tr '\n' ' ' < /proc/fb 2>/dev/null) $(cat /sys/class/graphics/fb0/virtual_size /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null | tr '\n' ' ')"
# Developer hook, only with "ramforge.debug" on the kernel command line: runs
# ramforge-debug/run.sh from the boot medium as root (X experiments on real
# hardware without rebuilding the ISO). Output: session log + serial console.
DBG=/run/live/medium/ramforge-debug/run.sh
if grep -qw ramforge.debug /proc/cmdline && [ -f "$DBG" ]; then
    log "Debug-Skript $DBG"
    bash "$DBG" >>"$LOG" 2>&1
    [ -w "$SERIAL" ] && tail -n 200 "$LOG" > "$SERIAL" 2>/dev/null
fi
chvt 1 2>/dev/null
setterm --term linux --blank 0 --powerdown 0 < /dev/tty1 > /dev/tty1 2>/dev/null

# Data on the boot stick if writable (FAT32/exFAT), otherwise only in RAM.
# Internal disks are never mounted.
DATA=/run/RAMForge-data
VOLATILE=1
MED=/run/live/medium
if mountpoint -q "$MED"; then
    FS="$(findmnt -no FSTYPE "$MED")"
    if [ "$FS" = "vfat" ] || [ "$FS" = "exfat" ]; then
        if mount -o remount,rw "$MED" 2>>"$LOG" && mkdir -p "$MED/RAMForge/RAMForge-data"; then
            DATA="$MED/RAMForge/RAMForge-data"
            VOLATILE=0
        fi
    fi
fi
mkdir -p "$DATA"
# Language from the boot menu entry (last locales= wins, as in live-config).
# English is the default; the app's DE/EN switch (saved on the stick) wins
# over this when the user picked a language there.
BOOTLANG=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^locales=//p' | tail -n 1 | cut -d, -f1)
case "$BOOTLANG" in de_*|en_*) ;; *) BOOTLANG=en_US.UTF-8 ;; esac
[ "$VOLATILE" = 1 ] && chown ramforge: "$DATA"
cat > /run/ramforge.env <<ENV
RAMFORGE_DATA=$DATA
RAMFORGE_DATA_VOLATILE=$VOLATILE
RAMFORGE_BOOT=1
RAMFORGE_EDITION=boot
RAMFORGE_VARIANT=$(cat /etc/ramforge-edition 2>/dev/null || echo full)
LANG=$BOOTLANG
ENV
log "Daten: $DATA (flüchtig=$VOLATILE), Medium: $(findmnt -no SOURCE,FSTYPE "$MED" 2>/dev/null)"
