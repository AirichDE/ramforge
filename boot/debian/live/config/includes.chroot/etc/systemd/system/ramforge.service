[Unit]
Description=RAMForge (Kiosk auf tty1)
# Started directly by systemd (no getty autologin), as the unprivileged user
# "ramforge": cage refuses to run as root. PAMName=login gives the process a
# logind session for screen and input access.
After=systemd-user-sessions.service systemd-logind.service live-config.service
Wants=systemd-logind.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=ramforge
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Root preparation (the "+" runs it with full privileges): drivers, data folder.
ExecStartPre=+/usr/local/bin/ramforge-prepare
ExecStart=/usr/local/bin/ramforge-session
# Exactly what RAMForge needs: lock test memory, read SPD/SMBIOS, write reports
# on the FAT32 stick.
AmbientCapabilities=CAP_IPC_LOCK CAP_DAC_OVERRIDE
LimitMEMLOCK=infinity
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
